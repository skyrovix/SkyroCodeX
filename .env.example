# ==========================================
# SkyroCodeX Environment Configuration
# ==========================================

# Execution Engine Configuration
# For local development: https://emkc.org/api/v2/piston (Default public API)
# For self-hosted production: http://localhost:2000/api/v2 (or your VPS address)
PISTON_API_URL=https://emkc.org/api/v2/piston

# Optional: Judge0 CE API (fallback or alternative)
# JUDGE0_API_URL=http://localhost:2358
# JUDGE0_API_KEY=

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate Limiting
# RATE_LIMIT_TYPE="memory" (for local dev) or "upstash" (for production serverless)
RATE_LIMIT_TYPE=memory
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Supabase Configuration (Phase 4)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

